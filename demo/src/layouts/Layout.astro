---
import Header from '../components/astro/Header.astro';
import Footer from '../components/astro/Footer.astro';
import { withBase } from '../lib/withBase';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Dynstruct & Dynstruct-MUI Demo Portal',
  description = 'Demonstration and architectural showcase of Dynstruct component model, Dynstruct-MUI, and MsgMesh bus in Astro SSR with React islands.',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Dynstruct Demo</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090d16" />
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('actdim_theme_preference');
          const isDark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (isDark) {
            document.documentElement.classList.add('dark');
            document.documentElement.setAttribute('data-theme', 'dark');
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 antialiased min-h-screen flex flex-col transition-colors duration-150">
    <Header currentPath={currentPath} />
    <main class="flex-1 w-full">
      <slot />
    </main>
    <Footer />
  </body>
</html>
