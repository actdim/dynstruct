---
import Layout from '../layouts/Layout.astro';
import { ShowcaseGalleryIsland } from '../components/islands/ShowcaseGalleryIsland';
---

<Layout title="Component Gallery">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
    <!-- Header Section -->
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 rounded-full border border-sky-500/30 bg-sky-500/10 px-3 py-1 text-xs font-medium text-sky-400 mb-3">
        <span>Design System Adapters</span>
        <span class="text-slate-500">/</span>
        <span>@actdim/dynstruct-mui</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
        Dynstruct-MUI Component Gallery
      </h1>
      <p class="mt-2 max-w-3xl text-base text-slate-400">
        Explore the suite of Material UI component wrappers adapted for Dynstruct contracts: Buttons, TextFields, Selects, Checkboxes, Switches, Sliders, Overlays, and Feedback indicators.
      </p>
    </div>

    <!-- Gallery Island Section -->
    <section class="rounded-xl border border-slate-800 bg-slate-900/40 p-6 shadow-xl">
      <ShowcaseGalleryIsland client:load />
    </section>
  </div>
</Layout>
