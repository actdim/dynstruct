{
    "extends": ["@actdim/dev-config/tsconfig/base.json", "@actdim/dev-config/tsconfig/loose.json"],
    "compilerOptions": {
        "declaration": false,
        "declarationMap": false,
        "emitDeclarationOnly": false,
        "sourceMap": false,
        "inlineSources": false,
        "inlineSourceMap": false,
        "allowImportingTsExtensions": true,
        "traceResolution": false,
        "removeComments": true,
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "types": [],
        // "jsx": "react",
        // "jsx": "react-jsx", // vite-specific
        "jsx": "preserve",
        "allowUmdGlobalAccess": true,
        "incremental": true,
        "noEmit": true,
        "noEmitOnError": true,
        // "newLine": "lf",
        // "noUnusedLocals": true,
        // "noUnusedParameters": true,
        "rootDir": ".",
        "paths": {
            "@/*": ["./src/*"]
        },
        "composite": true,
        "importHelpers": true
        // "preserveSymlinks": false
        // "preserveSymlinks": true // NO! use "npm pack" or "yalc" (not "npm link") or monorepo (pnpm, yarn workspaces, turborepo)
    }
}
