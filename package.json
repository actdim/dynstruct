{
    "name": "@actdim/dynstruct",
    "version": "1.7.0",
    "description": "Structure-first, type-safe component model for TypeScript and React apps with explicit dependency wiring and message bus communication.",
    "author": "Pavel Borodaev",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/actdim/dynstruct.git"
    },
    "bugs": {
        "url": "https://github.com/actdim/dynstruct/issues"
    },
    "homepage": "https://github.com/actdim/dynstruct/#readme",
    "keywords": [
        "typescript",
        "react",
        "type-safe",
        "component-model",
        "architecture",
        "frontend-architecture",
        "mobx",
        "state-management",
        "event-driven",
        "message-bus",
        "modularity",
        "clean-architecture",
        "enterprise",
        "ui-framework",
        "declarative",
        "microfrontends",
        "design-system"
    ],
    "files": [
        "dist",
        "docs",
        "README.md",
        "LICENSE",
        "AGENTS.md",
        "CLAUDE.md",
        "llms.txt",
        "llms-full.txt"
    ],
    "ai": {
        "instructions": "./AGENTS.md",
        "docs": "./docs",
        "llms": "./llms.txt",
        "llms-full": "./llms-full.txt"
    },
    "llms": "./llms.txt",
    "exports": {
        "./*": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.es.js"
        }
    },
    "typesVersions": {
        "*": {
            "*": [
                "dist/*.d.ts"
            ]
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false,
    "packageManager": "pnpm@10.21.0",
    "scripts": {
        "test": "npx vitest --config=vitest.node.config.ts --no-cache",
        "test:w": "npx vitest --config=vitest.node.config.ts --watch",
        "test:react": "npx vitest --config=vitest.react.config.ts --no-cache",
        "test:react:w": "npx vitest --config=vitest.react.config.ts --watch",
        "test:v8": "npx vite",
        "lint": "eslint \"./**/*.{ts,tsx}\" -f visualstudio --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
        "build": "tsc -b tsconfig.json && vite build",
        "pnpm:u": "pnpm update",
        "pnpm:ou": "pnpm outdated",
        "ncu:l": "ncu",
        "ncu:u": "ncu -u",
        "ncu:ud": "ncu -u --dev",
        "nvm:la": "nvm list available",
        "nvm:il": "nvm install lts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "typecheck": "tsc -b tsconfig.json",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs"
    },
    "peerDependencies": {
        "@actdim/msgmesh": ">=1.7.0",
        "@actdim/utico": ">=1.7.0",
        "http-status": ">=2.1.0",
        "jwt-decode": ">=4.0.0",
        "mobx": ">=6.15.0",
        "mobx-react-lite": ">=4.1.1",
        "mobx-utils": ">=6.1.1",
        "path-to-regexp": ">=8.3.0",
        "react": ">=19.2.0",
        "react-dom": ">=19.2.0",
        "react-router": ">=7.9.3",
        "react-router-dom": ">=7.9.4",
        "rxjs": ">=7.8.2",
        "uuid": ">=13.0.0"
    },
    "devDependencies": {
        "@braintree/sanitize-url": "^7.1.2",
        "@eslint/js": "^9.39.5",
        "@faker-js/faker": "^10.4.0",
        "@storybook/addon-docs": "10.6.0",
        "@storybook/addon-onboarding": "10.6.0",
        "@storybook/react-vite": "10.6.0",
        "@swc/core": "^1.16.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.10.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "chai": "^6.2.0",
        "cytoscape": "^3.34.3",
        "cytoscape-cose-bilkent": "^4.1.0",
        "dayjs": "^1.11.23",
        "debug": "^4.4.3",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-formatter-visualstudio": "^9.0.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.6",
        "eslint-plugin-storybook": "10.6.0",
        "globals": "^16.5.0",
        "happy-dom": "^20.14.0",
        "mermaid": "^11.4.1",
        "mocha": "^11.7.5",
        "npm-check-updates": "^19.1.2",
        "prettier": "^3.9.6",
        "prettier-plugin-classnames": "^0.8.5",
        "shx": "^0.4.0",
        "storybook": "10.6.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^7.2.2",
        "vite-plugin-dts": "^4.5.4",
        "vite-tsconfig-paths": "^5.1.4",
        "vitepress": "^1.6.4",
        "vitepress-plugin-mermaid": "^2.0.17",
        "vitest": "^4.0.8"
    }
}
